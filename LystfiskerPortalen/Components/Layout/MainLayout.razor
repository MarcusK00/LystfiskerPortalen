@inherits LayoutComponentBase

<div class="page">
    <header class="top-header">
        <div class="header-content">
            <div class="brand">
                <span class="logo-icon">🐟</span>
                <span class="logo-text">LystfiskerPortalen</span>
            </div>

            <div class="search-container">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Search anglers, locations..." class="search-input" />
            </div>

            <div class="nav-icons">
                <button class="nav-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
                <button class="nav-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </button>
                <button class="nav-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
                <button class="nav-btn profile-btn">
                    <div class="avatar-circle">JF</div>
                </button>
            </div>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>
</div>