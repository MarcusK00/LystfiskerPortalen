@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using LystfiskerPortalen.Models
@using LystfiskerPortalen.Components.Account

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Bekræfter email...</PageTitle>

@* Denne besked vises kun, hvis der opstår en fejl. 
   Ved succes bliver man viderestillet med det samme. *@
<h1>Bekræfter email</h1>
<StatusMessage Message="@statusMessage" />

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Hvis linket mangler data, send til forsiden
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"Fejl: Kunne ikke finde bruger med ID '{UserId}'.";
        }
        else
        {
            // Afkod bekræftelseskoden fra linket
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            
            // Forsøg at bekræfte emailen hos Identity
            var result = await UserManager.ConfirmEmailAsync(user, code);
            
            if (result.Succeeded)
            {
                // SUCCESS: Send brugeren direkte til Login-siden
                RedirectManager.RedirectTo("Account/Login");
            }
            else
            {
                statusMessage = "Fejl: Kunne ikke bekræfte din email.";
            }
        }
    }
}
