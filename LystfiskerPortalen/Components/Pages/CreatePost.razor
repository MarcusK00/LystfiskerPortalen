@inject IUserPostHttpService UserPostHttpService
@inject IFishHttpService FishHttpService
@inject ICatchHttpService CatchHttpService
@page "/create-post"
<h3>Create Post</h3>

<EditForm FormName="CreatePost" Model="PostVM" OnValidSubmit="Submit">
    <label for="description">Description</label>
    <InputTextArea @bind-Value="PostVM.Post.Description" placeholder="Write something here..." class="form-control mb-2" />

    <label for="fish">Fish</label>
    <InputSelect @bind-Value="PostVM.Catch.FishId" class="form-control mb-2">
        <option value="" disabled selected>Select Fish</option>
        @foreach (Fish fish in fishes)
        {
            <option value="@fish.Id">@fish.Species</option>
        }
    </InputSelect>

    <label for="weight">Weight (kg)</label>
    <InputNumber @bind-Value="PostVM.Catch.Weight" class="form-control mb-2" />

    <label for="length">Length (cm)</label>
    <InputNumber @bind-Value="PostVM.Catch.Length" class="form-control mb-2" />

    <label for="lure">Lure</label>
    <InputText @bind-Value="PostVM.Catch.Lure" class="form-control mb-2" />

    <label for="technique">Technique</label>
    <InputText @bind-Value="PostVM.Catch.Technique" class="form-control mb-2" />

    <label for="latitude">Location - Latitude</label>
    <InputNumber @bind-Value="PostVM.Catch.Location.Latitude" placeholder="Latitude" class="form-control mb-2" />

    <label for="longitude">Location - Longitude</label>
    <InputNumber @bind-Value="PostVM.Catch.Location.Longitude" placeholder="Longitude" class="form-control mb-2" />

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    private List<Fish> fishes = new();

    public class CreatePostViewModel // Maybe move to a separate file later??
    {
        public Catch Catch { get; set; } = new Catch() { Location = new Location() };
        public UserPost Post { get; set; } = new UserPost();
    }

    [SupplyParameterFromForm]
    public CreatePostViewModel PostVM { get; set; } = new();

    protected async override Task OnInitializedAsync()
    {
        fishes = await FishHttpService.GetAllAsync();
    }

    private async Task Submit()
    {
        await CatchHttpService.AddAsync(PostVM.Catch);
        await UserPostHttpService.AddAsync(PostVM.Post);
    }
}
