@inject IUserPostHttpService UserPostService


@foreach(var post in UserPosts)
{
    <div class="card post-card">
        <div class="post-header">
            <div class="user-meta">
                <div class="avatar small">Test</div>
                <div class="text-meta">
                    <span class="username">TestUser</span>
                </div>
            </div>
            <button class="btn-more">...</button>
        </div>

        <div class="post-image-container">
            <img src="@post.ImgSrc" alt="Catch" class="post-image" />
        </div>

        <div class="post-actions">
            <div class="action-left">
                <button class="icon-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
                <button class="icon-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                </button>
                <button class="icon-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                </button>
            </div>
            <div class="action-right">
                <button class="icon-btn">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                </button>
            </div>
        </div>

        <div class="post-content">
            <div class="caption">
                <span class="username">TestUserName</span> @post.Description
            </div>
        </div>

        <div class="catch-details">
            <div class="detail-header">
                🐟 Catch Details
            </div>
            <div class="detail-grid">
                <span>Lure: @post.Catch.Lure</span>
                <span>Weight: @post.Catch.Weight</span>
                <span>Length: @post.Catch.Length</span>
                <span>Technique: @post.Catch.Technique</span>
            </div>
        </div>

        <div class="map-placeholder">
            <span class="pin">📍</span>
            <span class="map-text">Latitude: @post.Catch.Location.Latitude, Longitude: @post.Catch.Location.Longitude</span>
        </div>
    </div>
        }


@code {
    List<UserPost> UserPosts = new List<UserPost>();

    protected async override Task OnInitializedAsync()
    {
        UserPosts = await UserPostService.GetAllAsync();
    }
}
