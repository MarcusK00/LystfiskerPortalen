@page "/create-post"
@using LystfiskerPortalen.Models
@* @inject IUserPostHttpService UserPostService *@

<h3>Opret nyt opslag</h3>

<EditForm Model="UserPost" OnValidSubmit="SavePost" FormName="CreatePostForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Beskrivelse af fangst</label>
        <InputTextArea @bind-Value="UserPost.Description" class="form-control" rows="3" />
    </div>

    <div class="mb-3">
        <label>Fisk art</label>
        <InputText @bind-Value="UserPost.CatchInfo.Fish.Species" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Vægt (kg)</label>
        <InputNumber @bind-Value="UserPost.CatchInfo.Weight" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Længde (cm)</label>
        <InputNumber @bind-Value="UserPost.CatchInfo.Length" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Blink/Lure</label>
        <InputText @bind-Value="UserPost.CatchInfo.Lure" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Teknik</label>
        <InputText @bind-Value="UserPost.CatchInfo.Technique" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Opret opslag</button>
</EditForm>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-2">@successMessage</div>
}

@code {
    private UserPost UserPost { get; set; } = new UserPost()
        {
            CatchInfo = new Catch(),
            Description = "New edsciptionsnn"
        };
    private string successMessage;

    private async Task SavePost()
    {
        try
        {
            await UserPostService.AddAsync(UserPost);
            successMessage = "Opslag oprettet!";
            UserPost = new UserPost() { CatchInfo = new Catch() }; 
        }
        catch (Exception ex)
        {
            successMessage = $"Fejl: {ex.Message}";
        }
    }
}



