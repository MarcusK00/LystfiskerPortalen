@page "/"


<div class="feed-layout">
    <aside class="sidebar-left">
        <div class="card profile-card">
            <div class="profile-header">
                <div class="avatar large">JF</div> <div class="profile-info">
                    <h3>John Fisher</h3>
                    <span class="handle">@@johnfisher</span>
                </div>
            </div>
            <div class="profile-stats">
                <div class="stat">
                    <span class="count">247</span>
                    <span class="label">Catches</span>
                </div>
                <div class="stat">
                    <span class="count">1.2k</span>
                    <span class="label">Followers</span>
                </div>
                <div class="stat">
                    <span class="count">892</span>
                    <span class="label">Following</span>
                </div>
            </div>
        </div>

        <div class="card locations-card">
            <h4>Popular Locations</h4>
            <ul class="location-list">
                <li><span class="pin-icon">📍</span> Lake Superior</li>
                <li><span class="pin-icon">📍</span> Florida Keys</li>
                <li><span class="pin-icon">📍</span> Colorado River</li>
            </ul>
        </div>
    </aside>

    <main class="feed-center">
        @foreach (var post in FeedPosts)
        {
            <div class="card post-card">
                <div class="post-header">
                    <div class="user-meta">
                        <div class="avatar small">@post.UserInitials</div>
                        <div class="text-meta">
                            <span class="username">@post.UserName</span>
                            <span class="time-loc">@post.TimeAgo • @post.Location</span>
                        </div>
                    </div>
                    <button class="btn-more">...</button>
                </div>

                <div class="post-image-container">
                    <img src="@post.ImageUrl" alt="Catch" class="post-image" />
                </div>

                <div class="post-actions">
                    <div class="action-left">
                        <button class="icon-btn">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        </button>
                        <button class="icon-btn">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        </button>
                        <button class="icon-btn">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        </button>
                    </div>
                    <div class="action-right">
                        <button class="icon-btn">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                        </button>
                    </div>
                </div>

                <div class="post-content">
                    <div class="likes">@post.Likes likes</div>
                    <div class="caption">
                        <span class="username">@post.Handle</span> @post.Caption
                    </div>
                </div>

                <div class="catch-details">
                    <div class="detail-header">
                        🐟 Catch Details
                    </div>
                    <div class="detail-grid">
                        <span>Lure: @post.Lure</span>
                        <span>Weight: @post.Weight</span>
                        <span>Weather: @post.Weather</span>
                    </div>
                </div>

                <div class="map-placeholder">
                    <span class="pin">📍</span>
                    <span class="map-text">@post.Location - North Shore</span>
                </div>

                <div class="view-comments">View all @post.CommentCount comments</div>
            </div>
        }
    </main>

    <aside class="sidebar-right">
        <div class="card suggested-card">
            <div class="card-header">
                <h4>Suggested Anglers</h4>
            </div>
            @foreach (var suggested in SuggestedUsers)
            {
                <div class="suggested-user">
                    <div class="avatar small">@suggested.Initials</div>
                    <div class="suggested-info">
                        <span class="name">@suggested.Name</span>
                        <span class="sub">@suggested.CatchCount catches</span>
                    </div>
                    <button class="btn-follow">Follow</button>
                </div>
            }
        </div>

        <div class="card trends-card">
            <h4>Trending Lures</h4>
            <div class="trend-item">
                <span>Spinnerbait</span>
                <span class="trend-up">+12%</span>
            </div>
            <div class="trend-item">
                <span>Crankbait</span>
                <span class="trend-up">+8%</span>
            </div>
            <div class="trend-item">
                <span>Dry Fly</span>
                <span class="trend-up">+15%</span>
            </div>
        </div>
    </aside>
</div>

@code {
  

    public class FeedPostModel
    {
        public string UserName { get; set; } = "";
        public string Handle { get; set; } = "";
        public string UserInitials { get; set; } = "";
        public string TimeAgo { get; set; } = "";
        public string Location { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public int Likes { get; set; }
        public string Caption { get; set; } = "";
        public string Lure { get; set; } = "";
        public string Weight { get; set; } = "";
        public string Weather { get; set; } = "";
        public int CommentCount { get; set; }
    }

    public class SuggestedUserModel
    {
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public int CatchCount { get; set; }
    }

   
    List<FeedPostModel> FeedPosts = new List<FeedPostModel>
    {
        new FeedPostModel
        {
            UserName = "Mike Bass",
            Handle = "mikebass",
            UserInitials = "MB",
            TimeAgo = "2 hours ago",
            Location = "Lake Michigan",
            
            ImageUrl = "/Images/BigBass.jpg",
            Likes = 247,
            Caption = "What a morning! Caught this beauty using a spinnerbait in about 15 feet of water. The fight lasted almost 10 minutes! 🎣",
            Lure = "Blue/Silver Spinnerbait",
            Weight = "4.2 lbs",
            Weather = "Overcast, 72°F",
            CommentCount = 23
        },
        new FeedPostModel
        {
            UserName = "Sarah Trout",
            Handle = "sarahtrout",
            UserInitials = "ST",
            TimeAgo = "5 hours ago",
            Location = "Rocky Mountain Stream",
            ImageUrl = "/Images/Trout.jpg",
            Likes = 182,
            Caption = "Nothing beats fly fishing in the mountains. Quiet and peaceful.",
            Lure = "Dry Fly",
            Weight = "1.5 lbs",
            Weather = "Sunny, 65°F",
            CommentCount = 12
        }
    };

    List<SuggestedUserModel> SuggestedUsers = new List<SuggestedUserModel>
